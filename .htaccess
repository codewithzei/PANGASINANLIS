# ============================================================
#  PangasinanLIS – Apache .htaccess
#  Root: /PangasinanLIS/
# ============================================================

Options -Indexes
Options -MultiViews

# ─── Engine ──────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /PangasinanLIS/

    # ── 1. Skip real files and directories ──────────────────
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 2. Root → index.php ─────────────────────────────────
    RewriteRule ^$ index.php [L]

    # ── 3. Clean URLs: serve filename.php when accessed without extension ──
    # If the path + ".php" exists as a real file, serve it transparently
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # ── 4. Short aliases ─────────────────────────────────────
    # /login     → pages/auth/login
    RewriteRule ^login/?$           pages/auth/login.php        [L]
    # /logout    → includes/auth_logout
    RewriteRule ^logout/?$          includes/auth_logout.php    [L]
    # /dashboard → pages/dashboard
    RewriteRule ^dashboard/?$       pages/dashboard.php         [L]
</IfModule>

# ─── PHP Settings ────────────────────────────────────────────
<IfModule mod_php.c>
    php_flag  display_errors     Off
    php_flag  log_errors         On
    php_value error_log          logs/php_errors.log
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
</IfModule>

# ─── Security Headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options          "SAMEORIGIN"
    Header always set X-Content-Type-Options   "nosniff"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection         "1; mode=block"
</IfModule>

# ─── Protect sensitive files ─────────────────────────────────
<FilesMatch "^(\.htaccess|\.env|db\.php|composer\.json|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ─── UTF-8 charset ───────────────────────────────────────────
AddDefaultCharset UTF-8